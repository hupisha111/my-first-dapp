  "metadata": "{\"compiler\":{\"version\":\"0.8.20+commit.a1b79de6\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"owner\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"spender\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"Approval\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"from\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"Transfer\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_owner\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"spender\",\"type\":\"address\"}],\"name\":\"allowance\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"spender\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"approve\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"account\",\"type\":\"address\"}],\"name\":\"balanceOf\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"burn\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"decimals\",\"outputs\":[{\"internalType\":\"uint8\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"mint\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"name\",\"outputs\":[{\"internalType\":\"string\",\"name\":\"\",\"type\":\"string\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"owner\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"symbol\",\"outputs\":[{\"internalType\":\"string\",\"name\":\"\",\"type\":\"string\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"totalSupply\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"transfer\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"from\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"value\",\"type\":\"uint256\"}],\"name\":\"transferFrom\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/HPSToken.sol\":\"HPSToken\"},\"evmVersion\":\"paris\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\",\"useLiteralContent\":true},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[]},\"sources\":{\"contracts/HPSToken.sol\":{\"content\":\"// SPDX-License-Identifier: MIT\\r\\npragma solidity >=0.8.0 <0.9.0;\\r\\n\\r\\ncontract HPSToken {\\r\\n    // ---------- \\u5143\\u6570\\u636e ----------\\r\\n    string public name = \\\"HPSToken\\\";\\r\\n    string public symbol = \\\"HPS202430550643\\\";\\r\\n    uint8 public decimals = 18;\\r\\n    uint256 public totalSupply;\\r\\n\\r\\n    // ---------- \\u6743\\u9650 ----------\\r\\n    address public owner;\\r\\n\\r\\n    modifier onlyOwner() {\\r\\n        require(msg.sender == owner, \\\"HPSToken: caller is not the owner\\\");\\r\\n        _;\\r\\n    }\\r\\n\\r\\n    // ---------- \\u72b6\\u6001 ----------\\r\\n    // \\u8fd9\\u4e24\\u4e2a mapping \\u5c31\\u662f\\u201c\\u8d26\\u672c\\u201d\\u3002\\u4ee3\\u5e01\\u4e0d\\u5b58\\u5728\\u4efb\\u4f55\\u94b1\\u5305\\u91cc\\uff0c\\u53ea\\u5b58\\u5728\\u4e8e\\u8fd9\\u91cc\\u3002\\r\\n    mapping(address => uint256) private _balances;\\r\\n    mapping(address => mapping(address => uint256)) private _allowances;\\r\\n\\r\\n    // ---------- \\u4e8b\\u4ef6 ----------\\r\\n    event Transfer(\\r\\n        address indexed from,\\r\\n        address indexed to,\\r\\n        uint256 value\\r\\n    );\\r\\n\\r\\n    event Approval(\\r\\n        address indexed owner,\\r\\n        address indexed spender,\\r\\n        uint256 value\\r\\n    );\\r\\n\\r\\n    constructor() {\\r\\n        owner = msg.sender;\\r\\n    }\\r\\n\\r\\n    // ---------- \\u53ea\\u8bfb\\u67e5\\u8be2 ----------\\r\\n    function balanceOf(address account) public view returns (uint256) {\\r\\n        return _balances[account];\\r\\n    }\\r\\n\\r\\n    function allowance(\\r\\n        address _owner,\\r\\n        address spender\\r\\n    ) public view returns (uint256) {\\r\\n        return _allowances[_owner][spender];\\r\\n    }\\r\\n\\r\\n    // ---------- TODO 1\\uff1a\\u8f6c\\u8d26 ----------\\r\\n    // \\u8981\\u6c42\\uff1ato \\u4e0d\\u80fd\\u662f\\u96f6\\u5730\\u5740\\uff1bmsg.sender \\u4f59\\u989d\\u5fc5\\u987b\\u8db3\\u591f\\uff1b\\r\\n    //      \\u6263 msg.sender\\u3001\\u52a0 to\\uff1b\\u53d1\\u51fa Transfer \\u4e8b\\u4ef6\\uff1b\\u8fd4\\u56de true\\u3002\\r\\n    function transfer(\\r\\n        address to,\\r\\n        uint256 value\\r\\n    ) public returns (bool) {\\r\\n        require(to != address(0), \\\"Invalid recipient\\\");\\r\\n        require(_balances[msg.sender] >= value, \\\"Insufficient balance\\\");\\r\\n\\r\\n        _balances[msg.sender] -= value;\\r\\n        _balances[to] += value;\\r\\n\\r\\n        emit Transfer(msg.sender, to, value);\\r\\n        return true;\\r\\n    }\\r\\n\\r\\n    // ---------- TODO 2\\uff1a\\u6388\\u6743 ----------\\r\\n    // \\u8981\\u6c42\\uff1a\\u8bb0\\u5f55 msg.sender \\u5141\\u8bb8 spender \\u82b1 value\\uff1b\\r\\n    //      \\u53d1\\u51fa Approval \\u4e8b\\u4ef6\\uff1b\\u8fd4\\u56de true\\u3002\\r\\n    function approve(\\r\\n        address spender,\\r\\n        uint256 value\\r\\n    ) public returns (bool) {\\r\\n          _allowances[msg.sender][spender] = value;\\r\\n\\r\\n          emit Approval(msg.sender, spender, value);\\r\\n          return true;\\r\\n    }\\r\\n\\r\\n    // ---------- TODO 3\\uff1a\\u4ee3\\u6263\\u8f6c\\u8d26 ----------\\r\\n    // \\u8981\\u6c42\\uff1afrom \\u7684\\u4f59\\u989d\\u5fc5\\u987b\\u8db3\\u591f\\uff1b\\r\\n    //      msg.sender \\u5728 from \\u5904\\u7684\\u989d\\u5ea6\\u5fc5\\u987b\\u8db3\\u591f\\uff1b\\r\\n    //      \\u989d\\u5ea6\\u51cf value\\uff1b\\u6263 from\\u3001\\u52a0 to\\uff1b\\r\\n    //      \\u53d1\\u51fa Transfer \\u4e8b\\u4ef6\\uff1b\\u8fd4\\u56de true\\u3002\\r\\n    function transferFrom(\\r\\n        address from,\\r\\n        address to,\\r\\n        uint256 value\\r\\n    ) public returns (bool) {\\r\\n          require(to != address(0), \\\"Invalid recipient\\\");\\r\\n          require(_balances[from] >= value, \\\"Insufficient balance\\\");\\r\\n          require(\\r\\n              _allowances[from][msg.sender] >= value,\\r\\n                \\\"Insufficient allowance\\\"\\r\\n            );\\r\\n\\r\\n            _allowances[from][msg.sender] -= value;\\r\\n            _balances[from] -= value;\\r\\n            _balances[to] += value;\\r\\n\\r\\n            emit Transfer(from, to, value);\\r\\n            return true;\\r\\n    }\\r\\n\\r\\n    // ---------- TODO 4\\uff1a\\u589e\\u53d1\\uff08\\u53ea\\u6709 owner \\u80fd\\u8c03\\uff09 ----------\\r\\n    // \\u8981\\u6c42\\uff1ato \\u4e0d\\u80fd\\u662f\\u96f6\\u5730\\u5740\\uff1btotalSupply \\u52a0 value\\uff1b\\r\\n    //      to \\u4f59\\u989d\\u52a0 value\\uff1b\\r\\n    //      \\u53d1\\u51fa Transfer \\u4e8b\\u4ef6\\uff0cfrom \\u586b address(0)\\u3002\\r\\n    function mint(address to, uint256 value) public onlyOwner {\\r\\n        require(to != address(0), \\\"Invalid recipient\\\");\\r\\n\\r\\n        totalSupply += value;\\r\\n        _balances[to] += value;\\r\\n\\r\\n    emit Transfer(address(0), to, value);\\r\\n    }\\r\\n\\r\\n    // ---------- TODO 5\\uff1a\\u9500\\u6bc1\\u81ea\\u5df1\\u7684\\u4ee3\\u5e01 ----------\\r\\n    // \\u8981\\u6c42\\uff1amsg.sender \\u4f59\\u989d\\u5fc5\\u987b\\u8db3\\u591f\\uff1b\\u4f59\\u989d\\u51cf value\\uff1b\\r\\n    //      totalSupply \\u51cf value\\uff1b\\r\\n    //      \\u53d1\\u51fa Transfer \\u4e8b\\u4ef6\\uff0cto \\u586b address(0)\\u3002\\r\\n    function burn(uint256 value) public {\\r\\n        require(_balances[msg.sender] >= value, \\\"Insufficient balance\\\");\\r\\n\\r\\n        _balances[msg.sender] -= value;\\r\\n        totalSupply -= value;\\r\\n\\r\\n        emit Transfer(msg.sender, address(0), value);\\r\\n    }\\r\\n}\",\"keccak256\":\"0x53beba96d95c8bb8c6312cb7c282a4c194dee28560b23cbcf50fddbc9aabfb00\",\"license\":\"MIT\"}},\"version\":1}",
